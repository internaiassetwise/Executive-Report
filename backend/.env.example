# Gemini analysis. Computed dashboards/reports remain available without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=45

# Local defaults. Railway injects PORT automatically and takes precedence.
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Unified CSV/XLSX ingestion. Install backend/requirements.txt with this Python.
PYTHON_BIN=python
DATASET_MAX_FILE_MB=25
DATASET_MAX_ROWS=100000
DATASET_MAX_COLUMNS=200
DATASET_MAX_CELLS=2000000
DATASET_MAX_CONCURRENT=2
DATASET_MAX_STORED=20
DATASET_TIMEOUT_SECONDS=120
DATASET_RETENTION_MINUTES=60
# Optional parent folder; each backend process creates a private subdirectory.
DATASET_TEMP_DIR=
