# Gemini analysis. Computed dashboards/reports remain available without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=45

# Local defaults. Railway injects PORT automatically and takes precedence.
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Unified CSV/XLSX ingestion. Install backend/requirements.txt with this Python.
PYTHON_BIN=python
DATASET_MAX_FILE_MB=25
DATASET_MAX_ROWS=100000
DATASET_MAX_COLUMNS=200
DATASET_MAX_CELLS=2000000
DATASET_MAX_CONCURRENT=2
DATASET_MAX_STORED=20
DATASET_TIMEOUT_SECONDS=120
DATASET_RETENTION_MINUTES=60
# Optional parent folder; each backend process creates a private subdirectory.
DATASET_TEMP_DIR=

# Shared password until company SSO exists. Required when NODE_ENV=production;
# without it every dataset request is refused. Changing it signs everyone out.
ACCESS_PASSWORD=
ACCESS_TTL_HOURS=12
# true = no password at all (anyone with the URL can upload and use the AI budget;
# keep AI_DAILY_REQUEST_LIMIT set). Overrides ACCESS_PASSWORD.
ACCESS_OPEN=false

# Cost guard: maximum Gemini requests per UTC day (one per analysed dataset).
# Token counts per request are logged as {"event":"ai_usage",...} lines.
AI_DAILY_REQUEST_LIMIT=200

# LLM provider: gemini (default, uses GEMINI_API_KEY/GEMINI_MODEL) or openai-compatible
# (OpenAI or a self-hosted model such as vLLM/Ollama; set LLM_BASE_URL to its /v1 root).
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Retired multi-request report endpoints (/api/plan, /api/report, /api/interpret).
LEGACY_AI_ENDPOINTS=false
